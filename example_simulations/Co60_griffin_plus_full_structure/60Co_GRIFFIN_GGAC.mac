# Co-60 decay at the centre of the standard 16-clover GRIFFIN array.
# Uses Geant4 11 photon-evaporation data and gamma-gamma angular correlations.
# Run from the build directory with:
#   ./Griffinv10 /absolute/path/to/60Co_GRIFFIN_GGAC.mac 1

############################ Physics #########################################
# All de-excitation configuration must be set before /run/initialize.
/process/had/deex/correlatedGamma true
/process/had/deex/maxTwoJ 20
/DetSys/phys/SelectPhysics emlivermore

/run/initialize

# Geant4 11.2 and newer otherwise ignore decays sampled later than one year.
# This command must be issued after /run/initialize.
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e60 year

#################### Optional user nuclear data #############################
# By default, the simulation reads Co-60 decay data from G4RADIOACTIVEDATA and
# Ni-60 level/transition data from G4LEVELGAMMADATA.
#
# To override either dataset, uncomment the corresponding command and replace
# the example with an absolute path. Keep these commands after /run/initialize
# and before /run/beamOn. The evaporation file is for the daughter Ni-60
# nucleus (Z=28), not the Co-60 parent (Z=27).
#
#/process/had/rdm/setRadioactiveDecayFile 27 60 /absolute/path/to/co60_decay.dat
#/process/had/rdm/setPhotoEvaporationFile 28 60 /absolute/path/to/z28.a60
#
# The photon-evaporation file must use the Geant4 11 level-data format and
# contain spin, multipolarity, and mixing-ratio values for angular correlations.
# Do not load the legacy 17-column UserEvapData_z28.a60 directly. Convert a
# legacy evaporation file plus its multipole file with the extension tool:
#
# python3 /path/to/Geant4GammaGammaAngularCorrelations10.01/tools/convert_legacy_level_data.py \
#   --evap UserEvapData_z28.a60 --multipoles Ni60Multipoles.dat \
#   --ground-spin 0 --output z28.a60

############################ Output ##########################################
/Histo/FileName Co60_GRIFFIN_GGAC
/Histo/RecordGun true
/Histo/RecordAll true

############################ GRIFFIN geometry ################################
# Standard full array: 16 clovers at 11 cm with forward extension suppressors.
# Set SetCustomShieldsPresent to 0 for an unsuppressed array.
/DetSys/det/SetCustomShieldsPresent 1
/DetSys/det/SetCustomRadialDistance 11 cm
/DetSys/det/SetCustomExtensionSuppressorLocation 0
/DetSys/det/includeGriffinHevimet 0

/DetSys/det/SetCustomPosition 1 1 0
/DetSys/det/addGriffinCustomDetector 1
/DetSys/det/SetCustomPosition 2 2 0
/DetSys/det/addGriffinCustomDetector 2
/DetSys/det/SetCustomPosition 3 3 0
/DetSys/det/addGriffinCustomDetector 3
/DetSys/det/SetCustomPosition 4 4 0
/DetSys/det/addGriffinCustomDetector 4
/DetSys/det/SetCustomPosition 5 5 0
/DetSys/det/addGriffinCustomDetector 5
/DetSys/det/SetCustomPosition 6 6 0
/DetSys/det/addGriffinCustomDetector 6
/DetSys/det/SetCustomPosition 7 7 0
/DetSys/det/addGriffinCustomDetector 7
/DetSys/det/SetCustomPosition 8 8 0
/DetSys/det/addGriffinCustomDetector 8
/DetSys/det/SetCustomPosition 9 9 0
/DetSys/det/addGriffinCustomDetector 9
/DetSys/det/SetCustomPosition 10 10 0
/DetSys/det/addGriffinCustomDetector 10
/DetSys/det/SetCustomPosition 11 11 0
/DetSys/det/addGriffinCustomDetector 11
/DetSys/det/SetCustomPosition 12 12 0
/DetSys/det/addGriffinCustomDetector 12
/DetSys/det/SetCustomPosition 13 13 0
/DetSys/det/addGriffinCustomDetector 13
/DetSys/det/SetCustomPosition 14 14 0
/DetSys/det/addGriffinCustomDetector 14
/DetSys/det/SetCustomPosition 15 15 0
/DetSys/det/addGriffinCustomDetector 15
/DetSys/det/SetCustomPosition 16 16 0
/DetSys/det/addGriffinCustomDetector 16

# Complete upstream and downstream GRIFFIN support structure.
/DetSys/app/addGriffinStructure 0

############################ Co-60 source ####################################
# A stationary Co-60 ion at the array centre.
/gun/particle ion
/gun/ion 27 60
/DetSys/gun/position 0 0 0 mm
/process/had/rdm/nucleusLimits 60 60 27 27

############################ Verbosity and run ###############################
/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Increase this for production statistics.
/run/beamOn 10000
